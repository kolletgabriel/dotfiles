news.version=3.4.1  # written by the program itself
data.location=$XDG_DATA_HOME/task

# First, shut the FUCK up:
verbose=0
nag=

# (Un)Setting colors:
color.uda.priority.H=
color.uda.priority.L=
color.uda.priority.M=
color.tagged=
color.tag.inbox=rgb115

# Simplifying urgency evaluation:
urgency.age.coefficient=0
urgency.annotations.coefficient=0
urgency.blocking.coefficient=0
urgency.project.coefficient=0
urgency.tags.coefficient=0

# Customizing `next` (the default) report:
report.next.columns=id,project,tags,description.count
report.next.filter=-maybe -inbox -WAITING (+ACTIVE or +next or pri:H) status:pending limit:0
report.next.labels=ID,Project,Tags,Description
report.next.sort=start-,urgency-,project+

# Adding `On Hold` report for `pri:M` tasks:
report.hold.description=On hold
report.hold.columns=id,project,tags,description.count
report.hold.filter=-WAITING pri:M status:pending limit:0
report.hold.labels=ID,Project,Tags,Description
report.hold.sort=project+,tags+,id+

# Adding `Minor` report for `pri:L` tasks:
report.minor.description=Minor stuff
report.minor.columns=id,project,tags,description.count
report.minor.filter=-maybe -inbox -WAITING pri:L status:pending limit:0
report.minor.labels=ID,Project,Tags,Description
report.minor.sort=project+,tags+,id+

# Report for GTD's inbox:
report.inbox.description=Inbox
report.inbox.columns=id,description.count
report.inbox.labels=ID,Description
report.inbox.filter=status:pending +inbox

# Report for GTD's "maybe" section:
report.maybe.description=Maybe
report.maybe.columns=id,description.count
report.maybe.labels=ID,Description
report.maybe.filter=status:pending +maybe
